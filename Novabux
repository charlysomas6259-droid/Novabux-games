        function initScratch(canvas) {
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = '#757b82';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            let active = false;
            function draw(event) {
                if (!active) return;
                event.preventDefault();
                const point = event.touches ? event.touches[0] : event;
                const rect = canvas.getBoundingClientRect();
                const x = (point.clientX - rect.left) * canvas.width / rect.width;
                const y = (point.clientY - rect.top) * canvas.height / rect.height;
                ctx.globalCompositeOperation = 'destination-out';
                ctx.beginPath();
                ctx.arc(x, y, 18, 0, Math.PI * 2);
                ctx.fill();
            }
            canvas.addEventListener('mousedown', e => { active = true; draw(e); });
            canvas.addEventListener('touchstart', e => { active = true; draw(e); }, { passive:false });
            canvas.addEventListener('mousemove', draw);
            canvas.addEventListener('touchmove', draw, { passive:false });
            window.addEventListener('mouseup', () => active = false);
            window.addEventListener('touchend', () => active = false);
        }

        function closeScratchScreen() {
            document.getElementById('scratchGameOverlay').classList.remove('active');
            if (currentTotalWinningTicketReward > 0) {
                currentWallet += currentTotalWinningTicketReward;
                alert(`🎉 Gains cumulés : +${currentTotalWinningTicketReward.toLocaleString('fr-FR')} € !`);
            } else {
                alert("Aucune combinaison gagnante. C'est perdu !");
            }
            currentTotalWinningTicketReward = 0;
            updateDisplay();
        }

        function initMinesGridHTML() {
            const grid = document.getElementById('minesGrid');
            grid.innerHTML = '';
            for (let i = 0; i < 20; i++) {
                const tile = document.createElement('div');
                tile.className = 'mine-tile';
                tile.id = `mine-tile-${i}`;
                tile.innerText = '?';
                tile.onclick = () => selectTile(i);
                grid.appendChild(tile);
            }
        }

        function startMinesGame() {
            if (minesActive) return;
            const bet = parseFloat(document.getElementById('minesBetAmount').value);
            if (!Number.isFinite(bet) || bet <= 0 || currentWallet < bet) return alert('Mise invalide ou solde insuffisant.');
            currentWallet -= bet;
            minesActive = true;
            minesBet = bet;
            minesSafeTilesDiscovered = 0;
            accumulatedBonus = 0;
            bombIndex = Math.floor(Math.random() * 20);
            minesGridState = new Array(20).fill('safe');
            minesGridState[bombIndex] = 'bombe';
            for (let i = 0; i < 20; i++) {
                const tile = document.getElementById(`mine-tile-${i}`);
                tile.className = 'mine-tile active-game';
                tile.innerText = '?';
            }
            document.getElementById('minesGameMessage').innerText = 'Partie lancée ! Évitez la bombe unique.';
            document.getElementById('btnMinesStart').style.display = 'none';
            document.getElementById('btnMinesCashout').style.display = 'block';
            updateDisplay();
            updateMinesPanel();
        }

        function updateMinesPanel() {
            let cashout = minesActive ? minesBet + accumulatedBonus : 0;
            if (minesActive && minesSafeTilesDiscovered === 19) cashout *= 2;
            document.getElementById('minesMegaJackpotAlert').innerText = minesActive ? (minesSafeTilesDiscovered === 19 ? '✨ MEGA JACKPOT ×2 ! ✨' : `Prochain clic réussi : +${formatEuro(minesBet)} €`) : '';
            document.getElementById('minesSafeCount').innerText = `${minesSafeTilesDiscovered} / 19`;
            document.getElementById('minesDisplayBet').innerText = `${formatEuro(minesActive ? minesBet : 0)} €`;
            document.getElementById('minesAccumulatedBonus').innerText = `${formatEuro(minesActive ? accumulatedBonus : 0)} €`;
            document.getElementById('minesTotalCashout').innerText = `${formatEuro(cashout)} €`;
        }

        function selectTile(idx) {
            if (!minesActive) return;
            const tile = document.getElementById(`mine-tile-${idx}`);
            if (tile.classList.contains('revealed-safe') || tile.classList.contains('revealed-bombe')) return;
            if (minesGridState[idx] === 'bombe') {
                tile.className = 'mine-tile revealed-bombe';
                tile.innerText = '💣';
                document.getElementById('minesGameMessage').innerText = '💥 Explosion ! Mise et bonus perdus.';
                endMines(false);
            } else {
                minesSafeTilesDiscovered++;
                accumulatedBonus += minesBet;
                tile.className = 'mine-tile revealed-safe';
                tile.innerText = '🍀';
                document.getElementById('minesGameMessage').innerText = `Bonne case ! +${formatEuro(minesBet)} €.`;
                if (minesSafeTilesDiscovered === 19) endMines(true);
                else updateMinesPanel();
            }
        }

        function cashoutMinesGame() {
            if (minesActive) endMines(true);
        }

        function endMines(win) {
            if (!minesActive) return;
            let finalGain = minesBet + accumulatedBonus;
            const completed = minesSafeTilesDiscovered === 19;
            minesActive = false;
            if (win) {
                if (completed) finalGain *= 2;
                currentWallet += finalGain;
                alert(completed ? `Grille vidée ! Gains doublés : +${formatEuro(finalGain)} € !` : `Cashout : +${formatEuro(finalGain)} €`);
            }
            const bomb = document.getElementById(`mine-tile-${bombIndex}`);
            bomb.innerText = '💣';
            bomb.className = 'mine-tile revealed-bombe';
            document.getElementById('btnMinesStart').style.display = 'block';
            document.getElementById('btnMinesCashout').style.display = 'none';
            updateDisplay();
            updateMinesPanel();
        }

        function createRandomCrashPoint() {
            const roll = Math.random();
            if (roll < .15) return 1.25 + Math.random() * .55;
            if (roll < .70) return 1.80 + Math.random() * 2.20;
            if (roll < .93) return 4.00 + Math.random() * 2.50;
            return 6.50 + Math.random() * 2.00;
        }

        function startRocketGame() {
            if (rocketActive) return;
            const bet = parseFloat(document.getElementById('rocketBetAmount').value);
            if (!Number.isFinite(bet) || bet <= 0) return alert('Entrez une mise valide.');
            if (currentWallet < bet) return alert('Solde en Euros insuffisant.');
            currentWallet -= bet;
            rocketBet = bet;
            rocketMultiplier = 1;
            rocketCrashAt = createRandomCrashPoint();
            rocketActive = true;
            const stage = document.getElementById('rocketStage');
            stage.className = 'rocket-stage running';
            document.getElementById('rocketCraft').style.bottom = '48px';
            document.getElementById('btnRocketStart').style.display = 'none';
            document.getElementById('btnRocketCashout').style.display = 'block';
            document.getElementById('rocketMessage').innerText = 'La fusée décolle... Cashout avant le crash !';
            updateDisplay();
            updateRocketPanel();
            clearInterval(rocketTimer);
            rocketTimer = setInterval(function () {
                if (!rocketActive) return;
                rocketMultiplier = Number((rocketMultiplier + .01).toFixed(2));
                updateRocketPanel();
                if (rocketMultiplier >= rocketCrashAt) {
                    crashRocketGame();
                }
            }, 30);
        }

        function updateRocketPanel() {
            const currentGain = rocketBet * rocketMultiplier;
            const multiplierText = `×${rocketMultiplier.toFixed(2).replace('.', ',')}`;
            document.getElementById('rocketDisplayBet').innerText = `${formatEuro(rocketActive ? rocketBet : 0)} €`;
            document.getElementById('rocketDisplayMultiplier').innerText = multiplierText;
            document.getElementById('rocketBigMultiplier').innerText = multiplierText;
            document.getElementById('rocketCashoutValue').innerText = `${formatEuro(rocketActive ? currentGain : 0)} €`;
            const height = Math.min(285, 48 + (rocketMultiplier - 1) * 52);
            document.getElementById('rocketCraft').style.bottom = `${height}px`;
            document.getElementById('rocketBigMultiplier').classList.toggle('danger', rocketMultiplier >= 3);
            if (rocketActive) document.getElementById('btnRocketCashout').innerText = `💰 CASHOUT ${formatEuro(currentGain)} €`;
        }

        function cashoutRocketGame() {
            if (!rocketActive) return;
            rocketActive = false;
            clearInterval(rocketTimer);
            rocketTimer = null;
            const gain = rocketBet * rocketMultiplier;
            currentWallet += gain;
            document.getElementById('rocketStage').className = 'rocket-stage';
            document.getElementById('rocketMessage').innerText = `✅ Cashout réussi à ×${rocketMultiplier.toFixed(2).replace('.', ',')} : +${formatEuro(gain)} €`;
            finishRocketButtons();
            updateDisplay();
            alert(`🚀 Cashout réussi ! Vous recevez ${formatEuro(gain)} €.`);
        }

        function crashRocketGame() {
            if (!rocketActive) return;
            rocketActive = false;
            clearInterval(rocketTimer);
            rocketTimer = null;
            const stage = document.getElementById('rocketStage');
            stage.className = 'rocket-stage crashed';
            document.getElementById('rocketMessage').innerText = `💥 Explosion à ×${rocketMultiplier.toFixed(2).replace('.', ',')} ! Votre mise de ${formatEuro(rocketBet)} € est perdue.`;
            finishRocketButtons();
            updateDisplay();
            setTimeout(function () {
                alert(`💥 La fusée a explosé à ×${rocketMultiplier.toFixed(2).replace('.', ',')} ! Mise perdue.`);
            }, 350);
        }

        function finishRocketButtons() {
            document.getElementById('btnRocketStart').style.display = 'block';
            document.getElementById('btnRocketCashout').style.display = 'none';
        }

        function resetRocketDisplay() {
            rocketMultiplier = 1;
            document.getElementById('rocketStage').className = 'rocket-stage';
            document.getElementById('rocketCraft').style.bottom = '48px';
            document.getElementById('rocketDisplayBet').innerText = '0,00 €';
            document.getElementById('rocketDisplayMultiplier').innerText = '×1,00';
            document.getElementById('rocketBigMultiplier').innerText = '×1,00';
            document.getElementById('rocketCashoutValue').innerText = '0,00 €';
        }

        function askGift() {
            const user = document.getElementById('targetUser').value.trim();
            const amount = parseInt(document.getElementById('giftAmount').value, 10);
            if (!user || !Number.isFinite(amount) || amount <= 0 || currentBalance < amount) return alert('Donation impossible.');
            openAppConfirm('Faire un cadeau', `Donner ${amount.toLocaleString('fr-FR')} Robux au joueur ${user} ?`, function () {
                currentBalance -= amount;
                updateDisplay();
                alert('Donation envoyée.');
            });
        }
    </script>
