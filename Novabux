            while (values.length < 12) {
                const randomVal = ticket.rewards[Math.floor(Math.random() * ticket.rewards.length)];
                const count = values.filter(v => v === randomVal).length;
                if (!winningValues.includes(randomVal) && count < 2) values.push(randomVal);
            }
            values.sort(() => Math.random() - .5);
            const counts = {};
            values.forEach(v => counts[v] = (counts[v] || 0) + 1);
            currentTotalWinningTicketReward = Object.entries(counts).reduce((total, [value, count]) => total + (count >= 3 ? Number(value) : 0), 0);
            values.forEach(val => {
                const icon = ticket.icons[ticket.rewards.indexOf(val)] || '❓';
