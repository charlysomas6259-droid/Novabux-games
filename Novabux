            const roll = Math.random();
            if (roll < .15) {
                const winners = ticket.rewards.slice(1).sort(() => Math.random() - .5).slice(0, 2);
                winningValues.push(...winners);
                values.push(winners[0], winners[0], winners[0], winners[1], winners[1], winners[1]);
            } else if (roll < .50) {
                const winner = ticket.rewards[1 + Math.floor(Math.random() * (ticket.rewards.length - 1))];
                winningValues.push(winner);
                values.push(winner, winner, winner);
