    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Roblox Hub & Novabux Simulator</title>
    <style>
        :root {
            --rbx-bg: #191b1d;
            --rbx-card-bg: #222529;
            --rbx-nav-bg: #2b3035;
            --rbx-primary: #00a2ff;
            --rbx-success: #00e676;
            --rbx-danger: #ff3b3b;
            --rbx-text: #ffffff;
            --rbx-muted: #b4b6b8;
        }
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }
        body {
            background: var(--rbx-bg);
            color: var(--rbx-text);
            padding-bottom: 60px;
        }

        /* --- PAGE ROBLOX HUB --- */
        #page-roblox-hub {
            display: block;
            padding: 30px 20px;
            max-width: 1200px;
            margin: 0 auto;
        }
        .school-banner {
            font-size: clamp(22px, 5vw, 38px);
            font-weight: bold;
            line-height: 1.25;
            margin: 0 0 22px;
            color: #ffca05;
            text-shadow: 0 0 18px rgba(255, 202, 5, 0.45);
            animation: schoolPulse 1.6s ease-in-out infinite;
        }
        .school-banner span { color: var(--rbx-success); text-shadow: 0 0 18px rgba(0, 230, 118, 0.5); }
        @keyframes schoolPulse {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.05); opacity: 0.85; }
        }
        .hub-hero {
            background: linear-gradient(135deg, #111417, #22262c);
            border: 2px solid var(--rbx-primary);
            border-radius: 12px;
            padding: 40px 20px;
            text-align: center;
            margin-bottom: 30px;
            box-shadow: 0 8px 25px rgba(0, 162, 255, 0.2);
        }
        .hub-hero h1 {
            font-size: 36px;
            font-weight: 900;
            margin-bottom: 10px;
            color: #fff;
        }
        .hub-hero p {
            color: var(--rbx-muted);
            font-size: 16px;
            margin-bottom: 25px;
        }
        .btn-play-now {
            background: var(--rbx-success);
            color: #000;
            font-size: 20px;
            font-weight: 900;
            padding: 16px 32px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: transform 0.2s, filter 0.2s;
            box-shadow: 0 4px 15px rgba(0, 230, 118, 0.4);
            width: auto;
            display: inline-block;
        }
        .btn-play-now:hover {
            filter: brightness(1.15);
            transform: scale(1.03);
        }

        /* --- INTERFACE DU JEU (NOVABUX) --- */
        #game-interface {
            display: none;
        }
        .rbx-header {
            background: var(--rbx-nav-bg);
            padding: 12px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            border-bottom: 2px solid #3a3f45;
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .rbx-left, .rbx-balances, .balance-item {
            display: flex;
            align-items: center;
        }
        .rbx-left { gap: 20px; }
        .rbx-balances { gap: 15px; }
        .rbx-logo {
            font-weight: 900;
            font-size: 24px;
            letter-spacing: -1px;
            cursor: pointer;
        }
        .user-tag {
            background: rgba(0, 162, 255, .2);
            padding: 4px 12px;
            border-radius: 4px;
            font-size: 14px;
            color: var(--rbx-primary);
            font-weight: bold;
            border: 1px solid var(--rbx-primary);
        }
        .balance-item {
            background: rgba(0, 0, 0, .4);
            padding: 8px 14px;
            border-radius: 6px;
            gap: 8px;
            font-weight: bold;
            border: 1px solid #3a3f45;
            white-space: nowrap;
        }
        .icon-robux {
            display: inline-block;
            flex-shrink: 0;
            width: 22px;
            height: 24px;
            background-color: transparent;
            background-image: url("data:image/png;base64,");
            background-repeat: no-repeat;
            background-position: center;
            background-size: contain;
        }
        .icon-euro { color: var(--rbx-success); font-weight: bold; }
        .rbx-nav {
            display: flex;
            background: var(--rbx-card-bg);
            border-bottom: 1px solid #333;
            overflow-x: auto;
            scrollbar-width: thin;
        }
        .rbx-nav-item {
            padding: 15px 22px;
            color: var(--rbx-muted);
            cursor: pointer;
            font-weight: bold;
            white-space: nowrap;
            border-bottom: 3px solid transparent;
            transition: .2s;
        }
        .rbx-nav-item.active {
            color: var(--rbx-text);
            border-bottom-color: var(--rbx-primary);
            background: rgba(255, 255, 255, .03);
        }
        .page-content {
            display: none;
            padding: 25px;
            max-width: 1200px;
            margin: 0 auto;
        }
        .page-content.active { display: block; }
        h2 {
            margin: 10px 0 20px;
            border-left: 4px solid var(--rbx-primary);
            padding-left: 12px;
            font-size: 22px;
        }
        .grid-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        .card {
            background: var(--rbx-card-bg);
            border-radius: 8px;
            padding: 20px;
            border: 1px solid #2f343a;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
        }
        .card-title { font-size: 18px; font-weight: bold; margin-bottom: 10px; }
        .card-desc { color: var(--rbx-muted); font-size: 14px; margin-bottom: 15px; flex-grow: 1; line-height: 1.45; }
        .card-price { font-size: 20px; font-weight: bold; margin-bottom: 15px; }
        button {
            background: var(--rbx-primary);
            color: white;
            border: none;
            padding: 12px 15px;
            border-radius: 5px;
            font-weight: bold;
            cursor: pointer;
            transition: filter .2s, transform .1s;
            width: 100%;
            touch-action: manipulation;
        }
        button:hover { filter: brightness(1.15); }
        button:active { transform: scale(.98); }
        button:disabled { cursor: not-allowed; filter: none; }
        .btn-secours { background: #d32f2f; }
        .input-box {
            background: #111;
            border: 1px solid #444;
            color: #fff;
            padding: 12px;
            border-radius: 4px;
            width: 100%;
            margin-bottom: 15px;
            font-size: 16px;
        }

        /* Couteaux */
        .knife-preview {
            width: 100%;
            height: 140px;
            background: #111;
            border-radius: 6px;
            margin-bottom: 15px;
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .knife-container { position: relative; width: 170px; height: 40px; transform: rotate(-15deg); }
        .k-handle { position: absolute; left: 0; top: 10px; height: 20px; width: 55px; border-radius: 4px 0 0 4px; z-index: 2; }
        .k-guard { position: absolute; left: 54px; top: 5px; width: 6px; height: 30px; background: #555; z-index: 3; border-radius: 2px; }
        .k-blade { position: absolute; left: 60px; top: 8px; height: 24px; width: 100px; z-index: 1; }
        .k-classic .k-handle { background: linear-gradient(#5c4033, #3d2b1f); border-bottom: 3px solid #251a12; }
        .k-classic .k-blade { background: linear-gradient(#d1d5db, #9ca3af); clip-path: polygon(0 20%, 80% 20%, 100% 50%, 80% 80%, 0 80%); }
        .k-plasma .k-handle { background: #222; border: 1px solid #00e5ff; box-shadow: 0 0 5px #00e5ff; }
        .k-plasma .k-guard { background: #00e5ff; }
        .k-plasma .k-blade { background: #00e5ff; box-shadow: 0 0 15px #00e5ff; clip-path: polygon(0 0, 70% 20%, 100% 0, 75% 80%, 0 100%); }
        .k-gold .k-handle { background: #111; border-left: 8px solid #d4af37; border-top: 2px solid #d4af37; border-bottom: 2px solid #d4af37; }
        .k-gold .k-guard { background: #d4af37; }
        .k-gold .k-blade { background: linear-gradient(45deg, #ffe066, #d4af37); clip-path: polygon(0 0, 100% 30%, 80% 70%, 0 100%); }
        .k-ruby .k-handle { background: linear-gradient(90deg, #4a0e17, #801828); }
        .k-ruby .k-guard { background: #ff1744; }
        .k-ruby .k-blade { background: #ff1744; box-shadow: 0 0 10px #ff1744; clip-path: polygon(0 30%, 75% 10%, 100% 50%, 75% 90%, 0 70%); }
        .k-void .k-handle { background: #050010; border: 1px solid #7b1fa2; }
        .k-void .k-guard { background: #7b1fa2; }
        .k-void .k-blade { background: linear-gradient(90deg, #4a148c, #7b1fa2); box-shadow: 0 0 20px #4a148c; clip-path: polygon(0 15%, 60% 0, 100% 50%, 80% 60%, 0 85%); }
        .k-cosmic .k-handle { background: radial-gradient(circle, #334, #112); border: 1px solid #ffeb3b; }
        .k-cosmic .k-guard { background: #ffeb3b; }
        .k-cosmic .k-blade { background: linear-gradient(90deg, #3f51b5, #e91e63, #ffeb3b); box-shadow: 0 0 25px #e91e63; clip-path: polygon(0 0, 100% 50%, 0 100%, 15% 50%); }

        /* Mines */
        .mines-wrapper, .rocket-wrapper {
            display: flex;
            flex-wrap: wrap;
            gap: 30px;
            background: var(--rbx-card-bg);
            padding: 25px;
            border-radius: 12px;
            border: 1px solid #333;
        }
        .mines-config, .rocket-config { flex: 1; min-width: 250px; }
        .mines-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; width: 100%; max-width: 420px; margin: 0 auto; }
        .mine-tile {
            aspect-ratio: 1;
            background: linear-gradient(135deg, #3a3f45, #2b3035);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            font-weight: bold;
            cursor: pointer;
            user-select: none;
            transition: .2s;
            box-shadow: inset 0 2px 4px rgba(255,255,255,.05), 0 4px 6px rgba(0,0,0,.2);
            border: 1px solid #4f555e;
        }
        .mine-tile.active-game:hover { transform: translateY(-2px); border-color: var(--rbx-primary); }
        .mine-tile.revealed-safe { background: linear-gradient(135deg, #2e7d32, #1b5e20); border-color: #81c784; transform: scale(.95); animation: popOpen .3s ease; }
        .mine-tile.revealed-bombe { background: linear-gradient(135deg, #d32f2f, #b71c1c); border-color: #ef5350; transform: scale(.95); box-shadow: 0 0 15px #f44336; animation: shake .3s ease; }
        @keyframes popOpen { from { transform: scale(.7); } to { transform: scale(.95); } }
        @keyframes shake { 0%,100% { transform: translateX(0) scale(.95); } 25% { transform: translateX(-4px) scale(.95); } 75% { transform: translateX(4px) scale(.95); } }

        /* Jeu de la fusée */
        .rocket-stage {
            flex: 1.5;
            min-width: 280px;
            height: 460px;
            position: relative;
            overflow: hidden;
            border-radius: 14px;
            border: 1px solid #334d78;
            background:
                radial-gradient(circle at 20% 18%, rgba(255,255,255,.8) 0 1px, transparent 2px),
                radial-gradient(circle at 72% 25%, rgba(255,255,255,.7) 0 1px, transparent 2px),
                radial-gradient(circle at 42% 55%, rgba(255,255,255,.7) 0 1px, transparent 2px),
                radial-gradient(circle at 85% 70%, rgba(255,255,255,.7) 0 1px, transparent 2px),
                linear-gradient(#071126, #102b55 56%, #184a78);
        }
        .rocket-stage::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 72px;
            background: linear-gradient(transparent, rgba(0,0,0,.55));
        }
        .rocket-cloud {
            position: absolute;
            bottom: 18px;
            left: 50%;
            width: 160px;
            height: 45px;
            transform: translateX(-50%);
            background: rgba(230,240,255,.65);
            border-radius: 50%;
            filter: blur(8px);
            opacity: 0;
            transition: opacity .2s;
            z-index: 2;
        }
        .rocket-stage.running .rocket-cloud { opacity: .8; animation: cloudPulse .6s infinite alternate; }
        .rocket-craft {
            position: absolute;
            z-index: 4;
            left: 50%;
            bottom: 48px;
            width: 74px;
            height: 145px;
            transform: translateX(-50%);
            transition: bottom .12s linear;
        }
        .rocket-stage.running .rocket-craft { animation: rocketShake .12s infinite alternate; }
        .rocket-body {
            position: absolute;
            left: 17px;
            top: 0;
            width: 40px;
            height: 100px;
            background: linear-gradient(90deg, #cbd5e1, #fff 48%, #8fa3b8);
            border-radius: 50% 50% 22% 22%;
            box-shadow: 0 0 18px rgba(255,255,255,.25);
        }
        .rocket-body::before {
            content: "";
            position: absolute;
            left: 8px;
            top: 25px;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: #00a2ff;
            border: 4px solid #48627b;
            box-shadow: inset 0 0 8px #fff;
        }
        .rocket-body::after {
            content: "";
            position: absolute;
            left: 13px;
            bottom: 8px;
            width: 14px;
            height: 18px;
            background: #e53935;
            border-radius: 4px;
        }
        .rocket-fin-left, .rocket-fin-right {
            position: absolute;
            top: 67px;
            width: 23px;
            height: 42px;
            background: #e53935;
        }
        .rocket-fin-left { left: 3px; clip-path: polygon(100% 0, 100% 100%, 0 100%); }
        .rocket-fin-right { right: 3px; clip-path: polygon(0 0, 100% 100%, 0 100%); }
        .rocket-flame {
            position: absolute;
            left: 25px;
            top: 96px;
            width: 24px;
            height: 48px;
            background: linear-gradient(#fff176, #ff9800 45%, #f44336 75%, transparent);
            clip-path: polygon(15% 0, 85% 0, 100% 55%, 50% 100%, 0 55%);
            transform-origin: top;
            opacity: 0;
        }
        .rocket-stage.running .rocket-flame { opacity: 1; animation: flame .1s infinite alternate; }
        .rocket-explosion {
            display: none;
            position: absolute;
            z-index: 8;
            left: 50%;
            top: 42%;
            transform: translate(-50%, -50%);
            font-size: 100px;
            filter: drop-shadow(0 0 30px #ff5722);
            animation: boom .55s ease-out;
        }
        .rocket-stage.crashed .rocket-craft { display: none; }
        .rocket-stage.crashed .rocket-explosion { display: block; }
        .rocket-multiplier {
            position: absolute;
            z-index: 6;
            top: 20px;
            left: 0;
            right: 0;
            text-align: center;
            font-size: clamp(36px, 8vw, 68px);
            font-weight: 900;
            color: #fff;
            text-shadow: 0 0 15px var(--rbx-primary), 0 3px 0 rgba(0,0,0,.45);
        }
        .rocket-multiplier.danger { color: #ffca28; text-shadow: 0 0 18px #ff5722; }
        .rocket-info {
            background: rgba(0,0,0,.3);
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 15px;
            border: 1px solid #444;
            line-height: 1.8;
        }
        .rocket-value { color: var(--rbx-success); font-weight: 900; font-size: 22px; }
        @keyframes rocketShake { from { transform: translateX(-51%) rotate(-.7deg); } to { transform: translateX(-49%) rotate(.7deg); } }
        @keyframes flame { from { transform: scaleY(.75); } to { transform: scaleY(1.15); } }
        @keyframes cloudPulse { from { transform: translateX(-50%) scale(.8); } to { transform: translateX(-50%) scale(1.15); } }
        @keyframes boom { from { transform: translate(-50%, -50%) scale(.2); opacity: .4; } to { transform: translate(-50%, -50%) scale(1.35); opacity: 1; } }

        /* Modales et grattage */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.85);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            padding: 20px;
        }
        .modal-overlay.active { display: flex; }
        .modal-box { background: var(--rbx-card-bg); padding: 25px; border-radius: 8px; width: 100%; max-width: 550px; border: 1px solid #444; }
        .confirm-box { background: #2e343a; border: 2px solid var(--rbx-primary); text-align: center; max-width: 450px; box-shadow: 0 10px 25px rgba(0,0,0,.5); padding: 30px; border-radius: 12px; }
        .confirm-title { font-size: 20px; font-weight: bold; margin-bottom: 15px; }
        .confirm-msg { font-size: 16px; margin-bottom: 25px; color: var(--rbx-muted); line-height: 1.5; }
        .confirm-buttons { display: flex; gap: 15px; }
        .btn-yes { background: var(--rbx-success); color: #000; }
        .btn-no { background: #555; }
        .scratch-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 20px; }
        .scratch-cell { background: #111; aspect-ratio: 1.3; border-radius: 6px; position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1px solid #444; overflow: hidden; }
        .scratch-canvas { position: absolute; inset: 0; width: 100%; height: 100%; cursor: crosshair; z-index: 5; touch-action: none; }
        .cell-inner-symbol { font-size: 24px; }
        .cell-inner-value { font-size: 11px; font-weight: bold; color: var(--rbx-success); white-space: nowrap; }

        @media (max-width: 650px) {
            .rbx-header { padding: 10px; align-items: flex-start; }
            .rbx-left { gap: 8px; flex-direction: column; align-items: flex-start; }
            .rbx-logo { font-size: 20px; }
            .rbx-balances { gap: 5px; flex-direction: column; align-items: stretch; }
            .balance-item { padding: 5px 8px; font-size: 12px; }
            .page-content { padding: 16px; }
            .scratch-grid { gap: 7px; }
            .scratch-cell { aspect-ratio: 1; }
            .mines-wrapper, .rocket-wrapper { padding: 15px; gap: 18px; }
            .mines-grid { gap: 7px; }
            .rocket-stage { height: 400px; }
        }
    </style>
</head>
<body>

    <!-- PAGE 1 : ROBLOX HUB -->
    <div id="page-roblox-hub">
        <div class="hub-hero">
            <div class="school-banner">L'école vient de commencer ? Pas grave, y'a <span>NOVABUX</span> !</div>
            <h1>Bienvenue sur Roblox Hub</h1>
            <p>Accédez aux meilleurs mini-jeux, échangez vos Robux et devenez le plus riche !</p>
            <button class="btn-play-now" onclick="launchNovabuxGame()">JOUER MAINTENANT</button>
        </div>
        <h2>Sélecteur de Mode</h2>
        <div class="grid-container">
            <div class="card">
                <div class="card-title">Novabux Simulator</div>
                <div class="card-desc">Accédez à la banque de Robux, la loterie, les couteaux légendaires et les mini-jeux de casino.</div>
                <button onclick="launchNovabuxGame()">Lancer Novabux</button>
            </div>
            <div class="card">
                <div class="card-title">Codes Proxi-Robux</div>
                <div class="card-desc">Débloquez des bonus exclusifs dans vos jeux Roblox préférés.</div>
                <button onclick="showPromoOfTheDay()">Obtenir un code</button>
            </div>
        </div>
    </div>

    <!-- PAGE 2 : JEU NOVABUX (Votre application) -->
    <div id="game-interface">
        <div class="rbx-header">
            <div class="rbx-left">
                <div class="rbx-logo" onclick="backToHub()">ROBLOX</div>
                <div class="user-tag" id="headerUserTag">llmc4man</div>
            </div>
            <div class="rbx-balances">
                <div class="balance-item"><div class="icon-robux"></div><span id="txtRobuxBalance">1 000</span> R$</div>
                <div class="balance-item"><span class="icon-euro">&#x20AC;</span><span id="txtWalletBalance">50,00</span> &#x20AC;</div>
            </div>
        </div>

        <div class="rbx-nav">
            <div class="rbx-nav-item active" id="nav-dashboard" onclick="switchPage('dashboard')">Profil & Pseudo</div>
            <div class="rbx-nav-item" id="nav-robuxshop" onclick="switchPage('robuxshop')">Boutique Robux & Premium</div>
            <div class="rbx-nav-item" id="nav-convert" onclick="switchPage('convert')">Banque & Conversion</div>
            <div class="rbx-nav-item" id="nav-scratch" onclick="switchPage('scratch')">Tickets à gratter XXL</div>
            <div class="rbx-nav-item" id="nav-knives" onclick="switchPage('knives')">Boutique de Couteaux</div>
            <div class="rbx-nav-item" id="nav-mines" onclick="switchPage('mines')">Mines Simulator</div>
            <div class="rbx-nav-item" id="nav-rocket" onclick="switchPage('rocket')">&#x1F680; Jeu de la Fusée</div>
        </div>

        <div class="page-content active" id="page-dashboard">
            <h2>Gestion du Profil Roblox</h2>
            <div class="card" style="max-width:500px;margin-bottom:30px">
                <div class="card-title">Choisir votre Pseudo</div>
                <div class="card-desc">Modifiez votre nom d'affichage sur la plateforme à tout moment.</div>
                <input type="text" id="inputUsername" class="input-box" value="llmc4man" placeholder="Nouveau pseudo...">
                <button onclick="updateUsername()">Mettre à jour le pseudo</button>
            </div>
            <h2>Code Promo</h2>
            <div class="card" style="max-width:500px;margin-bottom:30px;border-color:#ffca05">
                <div class="card-title" style="color:#ffca05">Entrez le code promo</div>
